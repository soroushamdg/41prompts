{
  "name": "@41prompts/core",
  "version": "0.0.1",
  "type": "module",
  "sideEffects": false,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/41prompts/41prompts.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/41prompts/41prompts/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/41prompts/41prompts/issues"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./fixtures": "./src/fixtures.ts"
  },
  "files": ["dist", "LICENSE", "NOTICE", "README.md"],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./fixtures": {
        "types": "./dist/fixtures.d.ts",
        "default": "./dist/fixtures.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "prepublishOnly": "test \"$GITHUB_REPOSITORY\" = 41prompts/41prompts"
  },
  "devDependencies": {
    "vitest": "^3.2.7"
  }
}
