[
  {
    "id": "json-fields",
    "check": "valid JSON shape",
    "severity": "high",
    "flags": "i",
    "pattern": "\\bfields?\\b[^.!?]{0,25}:|\\b(?:these|the following) fields\\b|\\bfields? that (?:are|is) not\\b"
  },
  {
    "id": "json-output",
    "check": "valid JSON shape",
    "severity": "high",
    "flags": "i",
    "pattern": "\\b(?:respond|reply|return|answer|output|format|produce|emit)\\w*\\b[^.!?]{0,40}\\bjson\\b|\\bjson\\b[^.!?]{0,25}\\bonly\\b|\\bvalid json\\b|\\bin json\\b"
  },
  {
    "id": "allowed-values",
    "check": "one of the allowed values",
    "severity": "high",
    "flags": "i",
    "pattern": "\\bone of (?:these|those|the following|the)\\b|\\b(?:classify|categori[sz]e|tag|rate|score)\\w*\\b[^.!?]{0,80}\\bas\\b[^.!?]{0,60}\\bor\\b"
  },
  {
    "id": "word-limit",
    "check": "word limit",
    "severity": "high",
    "flags": "i",
    "pattern": "\\b(?:at most|no more than|fewer than|under|maximum of|max(?:imum)?)\\b[^.!?]{0,20}\\b(?:\\d+|one|two|three|four|five)\\b[^.!?]{0,15}\\bwords?\\b|\\b(?:\\d+|one|two|three)\\s+words?\\b[^.!?]{0,30}\\b(?:only|and nothing else|maximum|at most)\\b|\\bwithin \\d+ words?\\b"
  },
  {
    "id": "character-limit",
    "check": "character limit",
    "severity": "high",
    "flags": "i",
    "pattern": "\\b(?:at most|no more than|fewer than|under|maximum of|max(?:imum)?|within)\\b[^.!?]{0,20}\\b\\d+\\b[^.!?]{0,15}\\bcharacters?\\b"
  },
  {
    "id": "must-contain",
    "check": "must contain",
    "severity": "medium",
    "flags": "i",
    "pattern": "\\b(?:always|must|make sure to|be sure to)\\s+(?:include|contain|mention|cite|state|add|append|prefix|link)\\b|\\balways (?:end|close|finish|sign off) with\\b|\\bwrite \"[^\"]+\" instead\\b"
  },
  {
    "id": "must-not-contain",
    "check": "must not contain",
    "severity": "medium",
    "flags": "i",
    "pattern": "\\b(?:never|do not|don't|must not|may not)\\s+(?:mention|include|contain|use|say|output|print|show|write|reveal|disclose|add|reference|expose)\\b"
  },
  {
    "id": "refuses-to-answer",
    "check": "refuses to answer",
    "severity": "medium",
    "flags": "i",
    "pattern": "\\b(?:refuse|decline)\\w*\\s+to\\s+(?:answer|respond|reply|engage|discuss|help)\\b|\\b(?:never|do not|don't|must not|may not|should not)\\s+(?:answer|respond|reply|engage)\\b"
  }
]
