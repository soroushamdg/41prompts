[
  {
    "key": "json-only",
    "flags": "i",
    "pattern": "\\b(?:json only|only json|no extra text|outside the json|explanation outside)\\b"
  },
  {
    "key": "markdown-forbidden",
    "flags": "i",
    "pattern": "\\b(?:no markdown|not use markdown|without markdown|avoid markdown)\\b"
  },
  {
    "key": "ai-identity",
    "flags": "i",
    "pattern": "\\b(?:mention|reveal|disclose|admit|say)\\b[^.!?]{0,40}\\bai (?:model|assistant|language model)\\b"
  },
  {
    "key": "tone-of-voice",
    "flags": "i",
    "pattern": "\\b(?:professional and friendly|tone of voice)\\b"
  }
]
