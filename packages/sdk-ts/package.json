{
  "name": "@41prompts/sdk",
  "version": "0.1.0",
  "description": "Resolve a 41Prompts prompt at runtime. Never blocks on the network, never throws, zero dependencies.",
  "type": "module",
  "sideEffects": false,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/41prompts/41prompts.git",
    "directory": "packages/sdk-ts"
  },
  "homepage": "https://github.com/41prompts/41prompts/tree/main/packages/sdk-ts#readme",
  "bugs": {
    "url": "https://github.com/41prompts/41prompts/issues"
  },
  "keywords": [
    "prompt",
    "llm",
    "prompt-management",
    "openai",
    "anthropic"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "main": "./dist/index.cjs",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "prepublishOnly": "test \"$GITHUB_REPOSITORY\" = 41prompts/41prompts"
  },
  "devDependencies": {
    "@41prompts/core": "workspace:*",
    "@types/node": "^22.20.4",
    "esbuild": "^0.25.12",
    "vitest": "^3.2.7"
  }
}
