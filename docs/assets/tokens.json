{
  "name": "41prompts Blueprint",
  "version": "1.0.0",
  "colorScheme": "dark",
  "color": {
    "ground": {
      "page": "#0A1830",
      "sheet": "#0C1C38",
      "raised": "#132849",
      "well": "#081428"
    },
    "chalk": {
      "1": "#E9F1FF",
      "2": "#C9D7EE",
      "3": "#93A9CB",
      "4": "#7D93B6"
    },
    "accent": "#9CC3FF",
    "line": {
      "1": "rgba(156,195,255,.14)",
      "2": "rgba(156,195,255,.28)",
      "3": "rgba(156,195,255,.45)"
    },
    "grid": {
      "major": "rgba(156,195,255,.07)",
      "minor": "rgba(156,195,255,.035)",
      "majorSizePx": 80,
      "minorSizePx": 16
    },
    "blok": {
      "context": "#9CC3FF",
      "constraint": "#FFD27A",
      "example": "#C6A8FF",
      "expects": "#6FE3A5"
    },
    "state": {
      "pass": "#6FE3A5",
      "fail": "#FF7A66",
      "failText": "#FF9A8A",
      "variable": "#FFD27A"
    },
    "stamp": {
      "background": "#E9F1FF",
      "foreground": "#0A1830",
      "glyph": "◆"
    }
  },
  "font": {
    "display": {
      "family": "Archivo",
      "weights": [
        700,
        800,
        900
      ],
      "use": "headlines, wordmark, prices"
    },
    "body": {
      "family": "IBM Plex Sans",
      "weights": [
        400,
        500,
        600
      ],
      "use": "UI and running text"
    },
    "mono": {
      "family": "Martian Mono",
      "weights": [
        400,
        500
      ],
      "use": "labels, IDs, metadata, compiled prompt, code"
    }
  },
  "type": {
    "label": {
      "size": 10.5,
      "tracking": "0.08em",
      "case": "upper",
      "font": "mono"
    },
    "xs": 12,
    "sm": 13,
    "base": 14,
    "md": 16,
    "lg": 18,
    "h3": 22,
    "h2": "clamp(30px, 3.6vw, 44px)",
    "h1App": 30,
    "h1Landing": "clamp(44px, 5.3vw, 78px)"
  },
  "space": {
    "unit": 4,
    "scale": [
      4,
      8,
      12,
      16,
      20,
      24,
      32,
      40,
      48,
      64,
      96
    ]
  },
  "radius": {
    "sheet": 2,
    "control": 7,
    "pill": 999
  },
  "frame": {
    "cornerLengthPx": 10,
    "cornerLengthHoverPx": 22,
    "cornerWidthPx": 2
  },
  "motion": {
    "easeBrand": "cubic-bezier(.32,.72,0,1)",
    "easeDraw": "cubic-bezier(.6,0,.2,1)",
    "durationMs": {
      "hover": 120,
      "small": 200,
      "panel": 500,
      "draw": 900
    }
  },
  "cursor": {
    "arrow": {
      "file": "cursors/cursor-arrow.svg",
      "hotspot": [
        5,
        3
      ],
      "fallback": "default"
    },
    "target": {
      "file": "cursors/cursor-target.svg",
      "hotspot": [
        16,
        16
      ],
      "fallback": "pointer"
    },
    "ibeam": {
      "file": "cursors/cursor-ibeam.svg",
      "hotspot": [
        16,
        16
      ],
      "fallback": "text"
    },
    "move": {
      "file": "cursors/cursor-move.svg",
      "hotspot": [
        16,
        16
      ],
      "fallback": "grab"
    },
    "cross": {
      "file": "cursors/cursor-cross.svg",
      "hotspot": [
        16,
        16
      ],
      "fallback": "crosshair"
    }
  }
}