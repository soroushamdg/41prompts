{
  "name": "41prompts",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint && pnpm boundaries && turbo boundaries && pnpm forbidden-words",
    "boundaries": "depcruise --config .dependency-cruiser.cjs packages/core/src packages/cli/src packages/sdk-ts/src apps/web/app apps/web/lib",
    "forbidden-words": "node scripts/forbidden-words.mjs",
    "binary-files": "node scripts/binary-files.mjs",
    "reuse-lint": "uvx --with charset-normalizer reuse lint",
    "license-gate": "node scripts/license-gate.mjs",
    "mirror-dry-run": "bash scripts/mirror-dry-run.sh",
    "compliance": "pnpm reuse-lint && pnpm boundaries && turbo boundaries && pnpm forbidden-words && pnpm binary-files && pnpm license-gate && pnpm mirror-dry-run",
    "db:generate": "pnpm --filter @41prompts/db db:generate",
    "db:migrate": "pnpm --filter @41prompts/db db:migrate",
    "db:seed": "pnpm --filter @41prompts/db db:seed",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@41prompts/cli": "workspace:*",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
