{
  "name": "41prompts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --port 3141",
    "build": "next build",
    "start": "next start --port 3141",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:studio": "drizzle-kit studio",
    "vercel-build": "node scripts/migrate.mjs --if-production && next build"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "5.0.113",
    "@ai-sdk/anthropic": "4.0.78",
    "@ai-sdk/azure": "4.0.99",
    "@ai-sdk/google": "4.0.93",
    "@ai-sdk/openai": "4.0.91",
    "@ai-sdk/openai-compatible": "3.0.67",
    "@sentry/nextjs": "11.6.0",
    "@vercel/functions": "^3.9.11",
    "ai": "7.0.136",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.4",
    "eventsource-parser": "^3.1.1",
    "fflate": "0.8.3",
    "motion": "14.0.0",
    "next": "16.4.0",
    "pg": "8.23.1",
    "posthog-js": "1.438.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.32.1",
    "server-only": "^0.0.1",
    "stripe": "23.0.0",
    "undici": "^7.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.64.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.0",
    "typescript": "^5.9.3",
    "vitest": "5.0.3"
  }
