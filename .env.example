# Database
# DATABASE_URL is for running apps/web or apps/worker directly with `pnpm dev` (no Docker).
# Inside `docker compose`, infra/docker-compose.yml overrides it to point at the `postgres`
# service using the three vars below, so keep POSTGRES_* filled in even if you never read
# DATABASE_URL's own value in that mode.
DATABASE_URL=postgres://41p:41p@localhost:5432/41p
POSTGRES_USER=41p
POSTGRES_PASSWORD=change-me
POSTGRES_DB=41p

# Deploy environment (compose passes this straight through to the web container; read by
# apps/web/app/healthz/route.ts). Set to "staging" or "production" in Coolify; leave as
# "development" for local Docker/`pnpm dev` use.
DEPLOY_ENV=development

# Auth (Better Auth). BETTER_AUTH_SECRET signs and encrypts sessions — generate a real one
# with `openssl rand -base64 32`, never reuse the local placeholder anywhere real.
BETTER_AUTH_SECRET=change-me
# The app's own base URL, read at runtime — never hard-coded. Staging and production each set
# their own value in Coolify (https://staging.41prompts.ai / https://app.41prompts.ai);
# see infra/README.md's "Auth secrets (EPIC-002)" section.
BETTER_AUTH_URL=http://localhost:3000
# Google and GitHub OAuth apps, one pair per environment (never share an app across
# environments — infra/README.md documents the exact callback URLs each needs).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email (Resend). Used to send magic-link sign-in emails; unset locally, sending silently
# no-ops (apps/web/lib/email.ts) so local dev and tests don't need a real key.
RESEND_API_KEY=
# Sender address, read at runtime — never hard-coded (EPIC-003). Staging leaves this unset and
# falls back to Resend's shared sandbox address (onboarding@resend.dev). Production sets
# `41Prompts <noreply@mail.41prompts.ai>` in Coolify once that domain is verified in Resend; see
# infra/README.md's "Auth secrets" section.
RESEND_FROM_ADDRESS=

# Providers (for eval runs; users may bring their own later)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Storage (Cloudflare R2, S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_ARTIFACTS=41p-artifacts
R2_BUCKET_BACKUPS=41p-backups

# Observability
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Key-encryption secret for BYO provider keys (32 bytes, base64)
KEY_ENCRYPTION_SECRET=
