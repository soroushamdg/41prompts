# Database
# DATABASE_URL is for running apps/web or apps/worker directly with `pnpm dev` (no Docker).
# Inside `docker compose`, infra/docker-compose.yml overrides it to point at the `postgres`
# service using the three vars below, so keep POSTGRES_* filled in even if you never read
# DATABASE_URL's own value in that mode.
DATABASE_URL=postgres://41p:41p@localhost:5432/41p
POSTGRES_USER=41p
POSTGRES_PASSWORD=change-me
POSTGRES_DB=41p

# Deploy environment (compose passes this straight through to the web container; read by
# apps/web/app/healthz/route.ts). Set to "staging" or "production" in Coolify; leave as
# "development" for local Docker/`pnpm dev` use.
DEPLOY_ENV=development

# Auth (Better Auth). BETTER_AUTH_SECRET signs and encrypts sessions — generate a real one
# with `openssl rand -base64 32`, never reuse the local placeholder anywhere real.
BETTER_AUTH_SECRET=change-me
# The app's own base URL, read at runtime — never hard-coded. Staging and production each set
# their own value in Coolify (https://staging.41prompts.ai / https://app.41prompts.ai);
# see infra/README.md's "Auth secrets (EPIC-002)" section.
BETTER_AUTH_URL=http://localhost:3000
# Google and GitHub OAuth apps, one pair per environment (never share an app across
# environments — infra/README.md documents the exact callback URLs each needs).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email (Resend). Used to send magic-link sign-in emails; unset locally, sending silently
# no-ops (apps/web/lib/email.ts) so local dev and tests don't need a real key.
RESEND_API_KEY=
# Sender address, read at runtime — never hard-coded (EPIC-003). Staging leaves this unset and
# falls back to Resend's shared sandbox address (onboarding@resend.dev). Production sets
# `41Prompts <noreply@mail.41prompts.ai>` in Coolify once that domain is verified in Resend; see
# infra/README.md's "Auth secrets" section.
RESEND_FROM_ADDRESS=

# Providers (for eval runs; users may bring their own later)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Storage (Cloudflare R2, S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_ARTIFACTS=41p-artifacts
R2_BUCKET_BACKUPS=41p-backups

# Observability (EPIC-004)
# Sentry: apps/web reads NEXT_PUBLIC_SENTRY_DSN for both its client and server/edge init — a
# Sentry DSN is public by design, and using one value keeps one project covering all of apps/web.
# apps/worker gets its own project/DSN (a different runtime, cleaner issue grouping).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Source-map upload at build time only (apps/web/next.config.ts's withSentryConfig) — org/project
# are plain config, SENTRY_AUTH_TOKEN is a secret that lives in GitHub Actions only, never here
# for real (infra/ACCESS.md rule 7's spirit). Unset locally/in CI: the upload step just no-ops.
SENTRY_ORG=
SENTRY_PROJECT_WEB=
SENTRY_AUTH_TOKEN=
# Level for packages/logger's pino instances (web and worker). One of pino's own level names.
LOG_LEVEL=info
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Key-encryption secret for BYO provider keys (32 bytes, base64)
KEY_ENCRYPTION_SECRET=

# Anonymous capture (EPIC-014)
# Per-deployment HMAC key for the caller hashes in `decompiles`. Unset is a working state — the
# process invents a random one and says so on every start — but abuse accounting then resets on
# every restart. 32 bytes of hex is plenty: `openssl rand -hex 32`.
IP_HASH_SALT=
# Cloudflare Turnstile, on permalink creation only. **Both or neither**: with one set the app turns
# Turnstile off entirely and logs an error, because a half-configured deployment used to refuse
# every share while looking protected (staging, 2026-09-11). The site key is public by design and
# carries the NEXT_PUBLIC_ prefix; the secret key never leaves the server.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
