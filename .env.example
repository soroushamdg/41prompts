# Database
# DATABASE_URL is for running apps/web or apps/worker directly with `pnpm dev` (no Docker).
# Inside `docker compose`, infra/docker-compose.yml overrides it to point at the `postgres`
# service using the three vars below, so keep POSTGRES_* filled in even if you never read
# DATABASE_URL's own value in that mode.
DATABASE_URL=postgres://41p:41p@localhost:5432/41p
POSTGRES_USER=41p
POSTGRES_PASSWORD=change-me
POSTGRES_DB=41p

# Deploy environment (compose passes this straight through to the web container; read by
# apps/web/app/healthz/route.ts). Set to "staging" or "production" in Coolify; leave as
# "development" for local Docker/`pnpm dev` use.
DEPLOY_ENV=development

# Auth (Better Auth)
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email
RESEND_API_KEY=

# Providers (for eval runs; users may bring their own later)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Storage (Cloudflare R2, S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_ARTIFACTS=41p-artifacts
R2_BUCKET_BACKUPS=41p-backups

# Observability
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Key-encryption secret for BYO provider keys (32 bytes, base64)
KEY_ENCRYPTION_SECRET=
