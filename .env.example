# 41prompts environment. Copy to .env for local work; set the same names in Vercel.
# NEXT_PUBLIC_* values are inlined at build time, so changing one needs a redeploy.

# ---- Hosts ------------------------------------------------------------------
# Public URL of the app (sign-in, library, editor). Prod: https://app.41prompts.ai
NEXT_PUBLIC_APP_URL=http://localhost:3141
# Public URL of the landing page. Prod: https://41prompts.ai
NEXT_PUBLIC_SITE_URL=http://site.localhost:3141
# 1 shows the maintenance page on both hosts, 0 turns it off. Unset: on in Vercel production, off elsewhere.
MAINTENANCE_MODE=

# ---- Database (Neon) --------------------------------------------------------
# Pooled Neon connection string used at runtime (the "-pooler" host).
DATABASE_URL=
# Direct (unpooled) Neon connection string used for migrations.
DATABASE_URL_UNPOOLED=
# Neon branch used only by the Playwright suite; its tables are truncated on every run.
E2E_DATABASE_URL=

# ---- Auth (Better Auth) -----------------------------------------------------
# Random secret of 32+ characters that signs sessions: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Google OAuth client; callback: <APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
# Google OAuth client secret.
GOOGLE_CLIENT_SECRET=
# GitHub OAuth app (one per environment); callback: <APP_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
# GitHub OAuth app secret.
GITHUB_CLIENT_SECRET=

# ---- Email (Resend) ---------------------------------------------------------
# Resend API key used to send magic sign-in links.
RESEND_API_KEY=
# Sender for sign-in emails, on a domain verified in Resend, e.g. "41prompts <signin@41prompts.ai>"
EMAIL_FROM=

# ---- Model keys -------------------------------------------------------------
# 32 random bytes, base64, that encrypt users' API keys at rest: openssl rand -base64 32
KEYS_ENCRYPTION_KEY=

# ---- Billing (Stripe, Managed Payments) -------------------------------------
# Stripe secret key (sk_test_... locally, sk_live_... in production).
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint <APP_URL>/api/stripe/webhook (or from `stripe listen`).
STRIPE_WEBHOOK_SECRET=
# Price ID of the monthly Performance plan.
STRIPE_PRICE_ID=
# true shows pricing and the upgrade path everywhere; false (default) hides them.
NEXT_PUBLIC_PRICING_ENABLED=false

# ---- Analytics (PostHog) ----------------------------------------------------
# PostHog project API key; leave empty to send nothing.
NEXT_PUBLIC_POSTHOG_KEY=
# PostHog ingest host, e.g. https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ---- Errors (Sentry) --------------------------------------------------------
# Sentry DSN; leave empty to send nothing.
NEXT_PUBLIC_SENTRY_DSN=
# Sentry auth token for uploading source maps at build time (Vercel only).
SENTRY_AUTH_TOKEN=
# Sentry organisation slug.
SENTRY_ORG=
# Sentry project slug.
SENTRY_PROJECT=

# ---- Operations -------------------------------------------------------------
# Secret Vercel Cron sends as a bearer token to /api/cron/purge: openssl rand -hex 24
CRON_SECRET=
# Address shown for support and in the legal pages.
NEXT_PUBLIC_SUPPORT_EMAIL=

# ---- Tests only -------------------------------------------------------------
# 1 turns on the mock model, the file mail outbox and no rate limits. Never set in Vercel.
E2E_MODE=
