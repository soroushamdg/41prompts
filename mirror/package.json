{
  "name": "41prompts",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "boundaries": "depcruise --config .dependency-cruiser.cjs packages/core/src packages/cli/src packages/sdk-ts/src",
    "reuse-lint": "uvx --with charset-normalizer reuse lint",
    "compliance": "pnpm reuse-lint && pnpm boundaries && pnpm exec turbo boundaries"
  },
  "devDependencies": {
    "@41prompts/cli": "workspace:*",
    "@eslint/js": "^9.39.5",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
